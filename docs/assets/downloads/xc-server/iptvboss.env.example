# DRAFT — Still Requires Final Review & Testing.
# Use "alpha" to follow the newest Alpha container. Pin an exact tested
# version for a long-running installation when one is available.
IPTVBOSS_TAG=alpha

# Caddy connects to this loopback-only host port. IPTVBoss continues to use
# port 8001 inside the container.
IPTVBOSS_HOST_PORT=8001

# The container runs without root privileges. Change these only when using a
# bind mount whose host ownership requires different IDs.
IPTVBOSS_UID=10001
IPTVBOSS_GID=10001

# Leave empty for the loopback-only setup in this guide. Docker NAT can make
# the host proxy appear as a bridge gateway; use the peer shown in IPTVBoss
# logs if strict proxy validation is enabled after testing.
IPTVBOSS_XC_TRUSTED_PROXIES=
