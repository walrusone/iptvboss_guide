# Use "alpha" to follow the newest Alpha container. Pin an exact tested
# version for a long-running installation when one is available.
IPTVBOSS_TAG=alpha

# Docker publishes the host port below. Set the host IP to 127.0.0.1 when
# only a reverse proxy running on the Docker host should reach IPTVBoss.
IPTVBOSS_HOST_IP=127.0.0.1
IPTVBOSS_HOST_PORT=8001

# Recommended when an HTTPS reverse proxy terminates TLS.
IPTVBOSS_XC_BEHIND_HTTPS_PROXY=true
IPTVBOSS_HTTPS_ONLY=false
IPTVBOSS_XC_BIND_ADDRESS=all
IPTVBOSS_XC_KEYSTORE_PASSWORD=

# The container runs without root privileges. Change these only when using a
# bind mount whose host ownership requires different IDs.
IPTVBOSS_UID=10001
IPTVBOSS_GID=10001

# Leave empty for a host-local proxy. If the published port is reachable by
# untrusted peers, set the actual proxy peer address or CIDR shown in logs.
IPTVBOSS_XC_TRUSTED_PROXIES=
